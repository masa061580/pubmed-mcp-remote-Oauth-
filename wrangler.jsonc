{
	"$schema": "https://json.schemastore.org/wrangler.json",
	"name": "pubmed-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Custom domain pubmed-mcp.med-ai-lounge.com is attached via the
	// Cloudflare dashboard (not managed here); workers.dev URL stays enabled.
	// KV namespace for OAuth token storage + per-user NCBI API keys (ncbi_key:<sub>).
	// If cloning this repo: wrangler kv namespace create OAUTH_KV, then update the id.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "e3d6267e8ff244fb9fae32a971098371"
		}
	]
	// Secrets (set via `wrangler secret put`):
	// - GOOGLE_CLIENT_ID
	// - GOOGLE_CLIENT_SECRET
	// - COOKIE_ENCRYPTION_KEY  (openssl rand -hex 32)
	//
	// Optional environment variables:
	// [vars]
	// NCBI_API_KEY = ""
}